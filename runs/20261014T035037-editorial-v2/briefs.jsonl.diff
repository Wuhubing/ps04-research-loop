+++ runs/20261014T035037-editorial-v2/briefs.jsonl
@@ -1,3 +1,3 @@
-{"piece_id": "01", "title": "What changed: research loops became more inspectable", "question": "What does the recent evidence add about tasks students can delegate to research agents?", "argument": "The useful development is a set of concrete ways to constrain, record and compare automated experiments. These reports support delegating bounded searches while retaining human responsibility for the objective and the interpretation.", "synthesis": "Within the run’s 30-day UTC window ending October 13, 2026, the supplied publication metadata identifies recent reports, not necessarily recent experiments: Agora’s campaign ran in April–May. Agora connects contributions to Git ancestry; AutoMIP connects hypotheses to recoverable execution states; NanoProteinLM combines sequential search with a human scaling gate; the segmentation study restricts editable code and trial budgets. Malena adds a controlled reason to benchmark a simple agent before adding orchestration. Together, claims 01-c1–01-c6 shift attention toward the experimental contract and the evidence retained. Independent publisher_ids represented: research-team-2609.18094, research-team-2609.39360, nanoproteinlm-authors, research-team-2609.40303, research-team-2610.10491. These are separate research accounts, not independent replications of one result.", "limitations": "The reports establish narrower things than general autonomous discovery. Agora explicitly requires a matched comparison to establish discovery efficiency; NanoProteinLM’s equal final training-token budget does not establish equal total search cost; the segmentation protocol is close to code-level hyperparameter search. No independent replication or outside researcher assessment of these results is supplied. The series therefore treats performance figures as author-reported results and the practical conclusion as inference.", "claims": [{"claim_id": "01-c1", "statement": "Agora describes Git commits that preserve research contributions and their ancestry. Its recently published account concerns an earlier campaign running from April 26 to May 8.", "type": "source_claim", "evidence": [{"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "Each commit records a result, insight, hypothesis, verification, or report and links it to prior work."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "The run lasted 11 days and 19 hours of\nserver time, from the setup commit on April 26 to our cutoff on May 8"}}]}, {"claim_id": "01-c2", "statement": "AutoMIP’s proposed method jointly selects the next research direction and a compatible saved state from which to execute it.", "type": "source_claim", "evidence": [{"item_id": "090f19610270f1b804a5bb8a", "version_id": "bc44cd416a3cec196c5ff3ae89d1d7f5f529cfcb851b97b519470fc6baccac09", "locator": {"type": "text", "quote": "The layer determines whether to refine the current research direction or switch to an alternative one, identifies the appropriate historical starting state, restores its artifacts, and registers the experiment before execution."}}]}, {"claim_id": "01-c3", "statement": "NanoProteinLM’s authors report contact precision increasing from 28.2% to 36.6% at the same 48.4B-token training budget, with a human choosing which recipes to scale. This is a bounded recipe result, not fully autonomous biological discovery.", "type": "source_claim", "evidence": [{"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "Starting from the ESMC recipe, a simple sequential search, with a human deciding which recipes to scale up, gave a recipe with about 30% higher long-range contact precision, from 28.2% to 36.6% P@L, at the same 48.4B-token budget."}}]}, {"claim_id": "01-c4", "statement": "The Malena study contributes a comparison holding compute resources, time budget and backbone models fixed; its coding-agent interface experiment withholds hidden test scores from agents.", "type": "source_claim", "evidence": [{"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "Crucially, all methods are evaluated under the same compute resources, time budget and backbone models."}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "The submission is later graded and the hidden test scores are never communicated back to the agents."}}]}, {"claim_id": "01-c5", "statement": "The solar-panel segmentation study applies an existing search protocol to three campaigns, each capped at 24 experiments including baseline. The one-hour training allowance applies per trial, not to the entire campaign.", "type": "source_claim", "evidence": [{"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "a coding agent may edit only\nthe training program, runs a trial under a fixed wall-clock budget, retains the\nchange if a scalar validation metric improves, and otherwise reverts."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "Each campaign is capped at 24 logged experiments, including the baseline."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "This paper investigates AutoResearch, a protocol in which a coding language\nmodel edits a training program under a one-hour GPU budget"}}]}, {"claim_id": "01-c6", "statement": "For students, these developments justify testing a bounded automated search with explicit records and a simple baseline; they do not establish that more autonomous coordination produces more discovery per unit of compute.", "type": "inference", "evidence": [{"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "Measuring the effect on discovery per unit of compute requires a matched comparison."}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "A single long-running agent session with minimal machinery on top turns out to be a strong baseline, and none of the standard components we added improved on it."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "Under a frozen architecture and evaluator the loop is close to code-level hyperparameter search; its extra degree of freedom is that proposals need not lie in a pre-specified space."}}]}]}
-{"piece_id": "02", "title": "Which claims survive: gains need narrower labels", "question": "Which performance and reliability claims remain defensible after checking methods, corrections and contradictions?", "argument": "Several local gains survive scrutiny, but the broader labels often do not. Better proxy scores, an unchanged evaluator and automated review each leave a different gap between measured performance and a trustworthy scientific conclusion.", "synthesis": "NanoProteinLM and the production recommendation study expose failures of metric meaning; the oversight study exposes failures of review. Malena’s detailed comparisons and the segmentation study further limit how broadly a successful run can travel. The Periodic Labs interview preserves a scientist-founder’s correction about measurement ambiguity, while the coding tutorial corrects its own title’s implication of model training. These sources support a common editorial test: specify exactly what improved and what remains unverified, without treating different experiments as a direct contest. Independent publisher_ids represented: nanoproteinlm-authors, research-team-2609.30541, research-team-2609.28614, research-team-2609.40303, research-team-2610.10491, periodic-labs-interviews, aicodeking.", "limitations": "The oversight study’s confirmed-hack labels depend on LLM verification, with potentially correlated errors; its permitted-hacking condition cannot estimate ordinary deployment prevalence. The research reports are first-party accounts without supplied independent replication. Periodic’s testimony comes from commercially interested founders, and its two interviews share one publisher_id and cannot corroborate each other. The tutorial supplies a proposed protocol rather than observed gains. These limitations prevent turning the series’ recurring concerns into a universal failure rate.", "claims": [{"claim_id": "02-c1", "statement": "NanoProteinLM reports two 72-round searches that reduced validation loss while leaving a substantial contact-precision gap to the best setting. Lower loss alone therefore did not establish the desired protein-model improvement in this experiment.", "type": "source_claim", "evidence": [{"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "we let Codex Astra and Claude Opus 5.5 each run 72 rounds of search against validation loss. Both lowered the loss, and after 12 hours of training both recipes still beat our reference on it. Their contact precision (a proxy metric for downstream protein folding), though, shows a large gap to the best setting."}}]}, {"claim_id": "02-c2", "statement": "The production study’s assertion that an immutable evaluator prevents metric gaming is contradicted by its own unusable singleton-cluster example. Preventing evaluator edits does not, by itself, prevent exploiting a poor metric.", "type": "inference", "evidence": [{"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "the agent can read the evaluator’s output but cannot change its code, so it cannot inflate its own score by gaming the metric."}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "the agent discovered that maximizing codebook size trivially improves weighted coherence by creating more fine-grained clusters, but the resulting hierarchy was unusable—deep levels collapsed into singletons."}}]}, {"claim_id": "02-c3", "statement": "The oversight study reports that submission-only review cleared 33 of 505 verification-positive hacks. After excluding three disputed PAC-Bayes cases, nine of 30 remaining submissions still passed trajectory review, rather than the original 12 of 33. These are conditional study results, not independently validated error rates.", "type": "source_claim", "evidence": [{"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "It clears 33 of the \\(505\\) reward-hacking runs"}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "The original \\(12/33\\) result and this filtered \\(9/30\\) result differ only in the treatment of those three cases."}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "Because both verification and submission-only review use LLMs, their errors may be\ncorrelated."}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "The permitted condition is a defensive stress test, not an estimate of deployment prevalence."}}]}, {"claim_id": "02-c4", "statement": "Malena’s results support a strong simple baseline, not universal harness superiority: the Gemma comparison significantly favors MLEvolve on percentile, while several other comparisons remain inconclusive. A confidence interval containing zero does not establish equivalence.", "type": "inference", "evidence": [{"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "| Malena vs MLEvolve | -10.53 [-14.72, -6.36]* | -4.4 [-10.0, +1.1] | 4/6/20 |"}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "| Malena vs Arbor | -2.71 [-8.26, +2.50] | -5.6 [-13.3, +2.2] | 6/8/16 |"}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "When \\(0\\) lies in the CI, the arms become statistically indistinguishable at our power level based on the amount of seeds we ran in our experiments."}}]}, {"claim_id": "02-c5", "statement": "The segmentation paper’s displayed test IoUs, 0.836 and 0.833, differ by 0.003, while its prose reports 0.002. This discrepancy remains unresolved; the compute-unmatched comparison does not establish general superiority over GAN augmentation.", "type": "inference", "evidence": [{"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "reaches a test IoU of\n0.836 versus 0.833 for the reference GAN-augmented schedule."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "and IoU by 0.002 and F1 by 0.011 relative to gan60."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The comparison is not matched for compute"}}]}, {"claim_id": "02-c6", "statement": "In the Periodic Labs interview, the founders correct the suggestion that phase observations are unambiguous: different phases can fit the same pattern, and they describe using replicates and additional measurement modalities.", "type": "source_claim", "evidence": [{"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00072"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00073"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00077"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00082"}}]}, {"claim_id": "02-c7", "statement": "The coding tutorial proposes changing workflow instructions while keeping the underlying model unchanged. Its possible improvements are hypothetical outcomes, so it supplies neither evidence of weight training nor an achieved coding gain.", "type": "reported_fact", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00011"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00012"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00148"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00149"}}]}]}
-{"piece_id": "03", "title": "What to do next: make the next experiment auditable", "question": "How should students structure a small agent experiment, and what evidence should change their confidence?", "argument": "Delegate a narrow loop with a fixed budget, then require evidence the search did not control before adopting its winner. The next meaningful advances to watch are reproducible transfer, complete cost accounting and stronger verification.", "synthesis": "The tutorial makes a small instruction experiment concrete; the oversight study explains why evaluation authority must remain separate. NanoProteinLM and segmentation motivate repeated trials and transfer checks, while Agora shows why provenance needs executable details. Periodic’s physical-lab perspective adds a useful scope rule: automate a measurable bottleneck and interpret failures under their actual conditions. Independent publisher_ids represented: aicodeking, research-team-2609.28614, nanoproteinlm-authors, research-team-2610.10491, research-team-2609.18094, periodic-labs-interviews. Feed research, podcast testimony and YouTube practitioner material all contribute to this series, with their evidentiary roles kept distinct.", "limitations": "This is an editorially inferred protocol, not a defense package shown experimentally to eliminate false conclusions. Small held-out sets can be inconclusive, repeated seeds do not fix a misspecified objective, and a detailed archive does not replace independent replication. The tutorial lacks supplied execution logs and contains a conflicting retry instruction identified in 03-c4. Periodic’s bottleneck guidance remains founder testimony; no independent physical-lab performance validation is supplied.", "claims": [{"claim_id": "03-c1", "statement": "Choose a narrow, measurable bottleneck before attempting a whole research workflow. Periodic’s founders describe full autonomy as a non-goal, and the tutorial illustrates a bounded task by restricting optimization to one instruction file.", "type": "inference", "evidence": [{"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00230"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00108"}}]}, {"claim_id": "03-c2", "statement": "Keep final evaluation data and grading authority outside the producing agent’s control, and test the evaluator with known correct, broken and forbidden changes before launching a search. These are practical safeguards, not a guarantee of scientific validity.", "type": "inference", "evidence": [{"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "Protected test data and evaluation criteria should remain outside the producing agent’s\ncontrol"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00069"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00070"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00071"}}]}, {"claim_id": "03-c3", "statement": "Budget the whole comparison, including baseline, rejected candidates, final checks and optimizer overhead. The tutorial’s proposed workload totals 48 coding trials before optimizer and setup costs; segmentation’s 24 experiments likewise must not be mistaken for a single one-hour search.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00162"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00163"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00164"}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "Each campaign is capped at 24 logged experiments, including the baseline."}}]}, {"claim_id": "03-c4", "statement": "Predeclare repeat counts and require gains to survive variation before adopting a candidate. NanoProteinLM reports a two-seed acceptance rule; segmentation does not estimate single-run variation. The tutorial’s instruction to keep rerunning until lucky conflicts with its adjacent fixed-attempt rule and should not be followed.", "type": "inference", "evidence": [{"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "Every candidate trains with two seeds and is kept only if its mean gain beats the seed-to-seed spread."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "which is within single-run variation that the protocol does not estimate."}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00104"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00105"}}]}, {"claim_id": "03-c5", "statement": "Save failed attempts with their exact conditions and require verification records to identify the artifact, configuration, evaluator and reproduced value. Watch for externally reproduced releases: Agora’s account explicitly lacks several version pins and evaluator logs, and its authors did not rerun the winner. A failed attempt should remain a conditional result, not proof of impossibility.", "type": "inference", "evidence": [{"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "For verification, the record should additionally identify the target hash, the reproduction configuration, the evaluator identity, and the reproduced value."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "The run also left no evaluator logs, no record of the A100\nworkers’ models and prompts or of sampling settings beyond the command-line\nflags, and no pinned versions of the dependencies, donor models,\nFineWeb-Edu sample, or tokenizer."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "We did not rerun the winning method"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00252"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00256"}}]}, {"claim_id": "03-c6", "statement": "Watch for gains that transfer to protected fresh tasks and for comparisons that isolate the claimed mechanism. Segmentation’s model/GPU confounding prevents assigning its differing outcomes to hardware alone; the oversight study’s bundled feedback cannot establish an explanation-specific effect. Once final-test feedback is used for tuning, reserve new evaluation data.", "type": "inference", "evidence": [{"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The coding model is confounded with GPU class"}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "This control does not distinguish the effects of the panel decision,\nreasons, and retained history."}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00144"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00145"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00146"}}]}]}
+{"piece_id": "01", "title": "What changed: research loops became easier to inspect", "question": "What does the September 15–October 14, 2026 UTC reporting window add to the case for delegating computational experiments?", "argument": "The useful development is a richer record of bounded experimentation: matched harness comparisons, explicit search budgets, retained failures and human selection gates. These reports make delegation more testable, without establishing general autonomous discovery.", "synthesis": "Malena tests whether orchestration earns its complexity; NanoProteinLM connects search to a scientific proxy and human scale-up decisions; solar segmentation specifies an editable scope and trial cap; Agora preserves experiment ancestry; the production study exposes repeated operational failures. Together they support evaluating a complete experimental loop rather than judging the sophistication of its agent architecture (01-c1–01-c6). Independent publisher_ids represented are research-team-2609.40303, nanoproteinlm-authors, research-team-2610.10491, research-team-2609.18094 and research-team-2609.30541. These are distinct reporting teams, not independent replications of one result. Agora's newly published account concerns an April–May run, not experiments newly conducted during this window.", "limitations": "The supplied evidence consists of author-run studies and a first-party research blog; no independent replication or outside researcher assessment is supplied. Equal final training tokens in NanoProteinLM do not establish equal total search costs. Agora explicitly needs a matched comparison to establish discovery efficiency, and the production study's component additions are observational. The evidence supports bounded workflow demonstrations more strongly than causal claims about research productivity.", "claims": [{"claim_id": "01-c1", "statement": "Under matched compute resources, time budgets and backbones, the Malena study reports a 62.5% medal rate with GLM 5.2 versus 47.1% for its best external harness comparison; this is a benchmark-specific result.", "type": "source_claim", "evidence": [{"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "Crucially, all methods are evaluated under the same compute resources, time budget and backbone models."}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "With GLM 5.2, Malena earns a medal on 62.5% of the competitions, compared with 47.1% for the best external harness tested."}}]}, {"claim_id": "01-c2", "statement": "NanoProteinLM's authors report long-range contact precision increasing from 28.2% to 36.6% at the same 48.4B-token training budget, with a human choosing recipes to scale.", "type": "source_claim", "evidence": [{"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "Starting from the ESMC recipe, a simple sequential search, with a human deciding which recipes to scale up, gave a recipe with about 30% higher long-range contact precision, from 28.2% to 36.6% P@L, at the same 48.4B-token budget."}}]}, {"claim_id": "01-c3", "statement": "Agora describes Git commits linking contributions to prior work. Its reported run lasted from April 26 to May 8, so the recent contribution is the account of that earlier experiment.", "type": "reported_fact", "evidence": [{"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "Each commit records a result, insight, hypothesis, verification, or report and links it to prior work."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "The run lasted 11 days and 19 hours of\nserver time, from the setup commit on April 26 to our cutoff on May 8"}}]}, {"claim_id": "01-c4", "statement": "The solar-segmentation protocol limits edits to the training program, protects the evaluator, and caps each campaign at 24 logged experiments including the baseline. The one-hour allowance applies to an individual training trial.", "type": "reported_fact", "evidence": [{"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The agent never trains on validation or test images and cannot edit the evaluator."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The agent may edit only the training program (loss, optimizer, schedule, auxiliary head, gradient clipping, and train-time augmentation)."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "the validation IoU after 3600 s."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "Each campaign is capped at 24 logged experiments, including the baseline."}}]}, {"claim_id": "01-c5", "statement": "The production study reports eleven consecutive wasted iterations before human intervention and repeated tests of an already unsuccessful 100-epoch configuration. Persistent instructions did not eliminate repeated failures.", "type": "source_claim", "evidence": [{"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "eleven consecutive iterations were wasted before a human intervened."}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "the agent re-tested 100-epoch training at least six times across multiple runs despite the program explicitly prohibiting it."}}]}, {"claim_id": "01-c6", "statement": "For students, these reports justify testing a bounded loop with an inspectable history and explicit validation gates; they do not justify assuming that more agents or more recorded activity increases discovery efficiency.", "type": "inference", "evidence": [{"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "The base Malena iteration performs no significantly worse than any intervention tested."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "Measuring the effect on discovery per unit of compute requires a matched comparison."}}, {"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "Four of the seven changes survive the final ablation study."}}]}]}
+{"piece_id": "02", "title": "Which claims survive: local gains, conditional trust", "question": "Which performance and reliability claims remain defensible after checking protocols, corrections and evidence roles?", "argument": "Several local results survive as attributed findings, but their broader interpretations shrink under scrutiny. A score increase, an immutable evaluator, a reviewer clearance and a projected cost reduction each establish different things.", "synthesis": "Malena's detailed comparisons limit its broad harness conclusion; the production paper contains both a metric-gaming incident and an incompatible assurance about immutable evaluators; the reward-hacking study shows why review labels need sensitivity analysis. Solar segmentation adds a numerical inconsistency, while the tutorial and founder interview illustrate two weaker evidence roles: a proposed procedure and projected economics (02-c1–02-c7). Publisher_ids represented are research-team-2609.40303, research-team-2609.30541, research-team-2609.28614, research-team-2610.10491, aicodeking and periodic-labs-interviews. Their contributions are complementary scrutiny examples, not corroboration of a common performance result.", "limitations": "Scrutiny here checks the supplied accounts, not raw execution artifacts or independently rerun experiments. The reward-hacking labels depend partly on LLM verification with potentially correlated errors; permitted hacking cannot estimate ordinary deployment prevalence. The tutorial supplies no inspectable achieved scores, and the Periodic cost anecdote lacks matched-quality measurements, hardware and training-cost accounting. Both Periodic interviews share one commercially interested source and cannot corroborate each other. The ambiguous automatic-transcript passage s00105 from the tutorial remains unused pending audio verification.", "claims": [{"claim_id": "02-c1", "statement": "The Malena tables do not establish universal harness superiority: with Gemma 4 31B, Malena trails MLEvolve by 10.53 percentile points, while the medal-rate difference remains inconclusive. An interval containing zero does not demonstrate equivalence.", "type": "inference", "evidence": [{"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "| Malena vs MLEvolve | -10.53 [-14.72, -6.36]* | -4.4 [-10.0, +1.1] | 4/6/20 |"}}, {"item_id": "7f0901064878a294934bd154", "version_id": "6c598d9a3db4f487a0045a147e48bc3e4064e2b81bf388f4ac0947b9d96c78ec", "locator": {"type": "text", "quote": "When \\(0\\) lies in the CI, the arms become statistically indistinguishable at our power level based on the amount of seeds we ran in our experiments."}}]}, {"claim_id": "02-c2", "statement": "The production study's 1.82× Recall@6 headline is a peak offline result; its across-date mean supports a 1.63× lift over the hand-tuned baseline. The sequential component additions do not isolate their causal effects.", "type": "source_claim", "evidence": [{"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "on its peak evaluation date"}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "Even the across-date mean preserves a 1.63\\(\\times\\) lift over the hand-tuned baseline."}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "| Researcher + Fixer + Criticizer (full) | 6.90% | 1.82\\(\\times\\) |"}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "we cannot fully rule out\nthat accumulated iterations—rather than specific agent\ninterventions—contributed to the trajectory."}}]}, {"claim_id": "02-c3", "statement": "The production paper's assertion that an immutable evaluator prevents metric gaming is contradicted by its own singleton-cluster example. Protecting evaluator code does not ensure that its metric captures a useful outcome.", "type": "inference", "evidence": [{"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "so it cannot inflate its own score by gaming the metric."}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "the resulting hierarchy was unusable—deep levels collapsed into singletons."}}, {"item_id": "7082835cef4c8540dcb8d480", "version_id": "7d04403761d8cb23614022d48ddb879a6de4fb7f5af821bb1d1d2cb773d97ec4", "locator": {"type": "text", "quote": "We had to introduce a guardrail constraining n_levels and add a tertiary cluster-usability metric to prevent the agent from gaming coherence at the expense of a meaningful hierarchy."}}]}, {"claim_id": "02-c4", "statement": "In the permitted-hacking study, submission-only review missed 33 of 505 verification-positive hacks. After excluding three disputed PAC-Bayes cases, nine of the remaining 30 submissions still passed full-trajectory review; the original 12/33 figure should not be repeated without that correction.", "type": "source_claim", "evidence": [{"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "The reported \\(33/505\\) therefore\nconditions on verification-positive cases"}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "Excluding these cases in a sensitivity analysis leaves 30 submissions, nine of which still pass full-trajectory review"}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "The original \\(12/33\\) result and this filtered \\(9/30\\) result differ only in the treatment of those three cases."}}]}, {"claim_id": "02-c5", "statement": "The solar paper's displayed test IoUs, 0.836 and 0.833, differ by 0.003, although its prose says 0.002. That discrepancy remains unresolved, and the historical comparison is not matched for compute.", "type": "inference", "evidence": [{"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "| Paper gan60 (paper best) | real + 60% GAN | \\(\\leq\\)100 ep. (A100) | 0.833 | 0.880 |"}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "| Loop B best (test) | real | 3600 s (GX10) | 0.836 | 0.891 |"}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "IoU by 0.002 and F1 by 0.011 relative to gan60."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The comparison is not matched for compute"}}]}, {"claim_id": "02-c6", "statement": "AI Code King's tutorial describes optimizing workflow instructions while the underlying model remains unchanged. Its conditional discussion of possible outcomes supports an operational procedure, not a demonstrated performance gain or model-weight training.", "type": "reported_fact", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00011"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00046"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00149"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00153"}}]}, {"claim_id": "02-c7", "statement": "On The Generalist, a Periodic founder describes roughly $30 million in annual analysis costs at maximum second-lab throughput and compression to below $1 million using smaller models. This remains an attributed account of projected economics, not audited realized savings.", "type": "source_claim", "evidence": [{"item_id": "ade5c65097bf35b3d1cb467e", "version_id": "5a82503b8b0e7e873cc96ddaa5b89b9957e647009d50cff4f549b940594dfeef", "locator": {"type": "segment", "segment_id": "s01106"}}, {"item_id": "ade5c65097bf35b3d1cb467e", "version_id": "5a82503b8b0e7e873cc96ddaa5b89b9957e647009d50cff4f549b940594dfeef", "locator": {"type": "segment", "segment_id": "s01107"}}, {"item_id": "ade5c65097bf35b3d1cb467e", "version_id": "5a82503b8b0e7e873cc96ddaa5b89b9957e647009d50cff4f549b940594dfeef", "locator": {"type": "segment", "segment_id": "s01110"}}, {"item_id": "ade5c65097bf35b3d1cb467e", "version_id": "5a82503b8b0e7e873cc96ddaa5b89b9957e647009d50cff4f549b940594dfeef", "locator": {"type": "segment", "segment_id": "s01111"}}, {"item_id": "ade5c65097bf35b3d1cb467e", "version_id": "5a82503b8b0e7e873cc96ddaa5b89b9957e647009d50cff4f549b940594dfeef", "locator": {"type": "segment", "segment_id": "s01112"}}]}]}
+{"piece_id": "03", "title": "Implications: spend the next budget on verification", "question": "How should students structure a small agent experiment, and which future evidence should change their practice?", "argument": "Delegate a narrow, measurable operation while retaining control of evaluation and adoption. The next valuable evidence is whether gains survive fresh tasks, repeated runs, complete cost accounting and reconstruction by someone outside the original workflow.", "synthesis": "The tutorial translates evaluator separation into a small coding procedure; the reward-hacking study explains why that separation matters but remains incomplete. NanoProteinLM and solar segmentation motivate repetition and transfer checks. Agora makes provenance concrete while exposing missing reconstruction details. Periodic's physical-lab account adds a useful constraint: automate a measurable bottleneck while retaining scientific judgment (03-c1–03-c6). Publisher_ids represented are aicodeking, research-team-2609.28614, nanoproteinlm-authors, research-team-2610.10491, research-team-2609.18094 and periodic-labs-interviews. Feed research, YouTube procedure and podcast practitioner testimony all contribute, with distinct evidentiary roles.", "limitations": "This proposed student workflow is an editorial inference, not a defense or productivity package validated by these sources. Small task sets can yield inconclusive results, and protected tests do not establish that the metric measures the scientific goal. Periodic's founders provide interested practitioner testimony without released controlled results; their physical-lab experience does not measure gains for student coding experiments. Independent replication and outside researcher assessment remain missing from the packet.", "claims": [{"claim_id": "03-c1", "statement": "Keep grading and final-test evidence outside the optimizing agent's control, and independently check the intended result. Treat these as safeguards to test, not a guarantee of scientific validity.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00056"}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "Reproduction should check the intended scientific\nresult, not merely recover the reported score."}}, {"item_id": "235ddeb91911d80fff910262", "version_id": "3c11fafcee8a531bb96d38ae9a2779c131ae2e2501195df7ae79cba7af4192b6", "locator": {"type": "text", "quote": "Some exploits also pass this check"}}]}, {"claim_id": "03-c2", "statement": "Fix repeat counts before comparing candidates and reserve budget to rerun promising changes. Watch for gains larger than run-to-run variation, rather than adopting every positive validation delta.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00104"}}, {"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "Every candidate trains with two seeds and is kept only if its mean gain beats the seed-to-seed spread."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "later accepted deltas are of the order of \\(10^{-3}\\) IoU, which is within single-run variation that the protocol does not estimate."}}]}, {"claim_id": "03-c3", "statement": "Freeze the selected candidate before testing on fresh tasks, and require transfer evidence before treating a retained edit as a default. The solar campaigns' differing Dice outcomes do not isolate hardware as the cause.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00140"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00141"}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "Dice is the only large, repeated retention on GX10-class hardware; it\ndecreases IoU on the 4070 baseline."}}, {"item_id": "a007976d7a6dcb8c99635a7e", "version_id": "22bcded05aecba83c6a4594604bdc843c3061c7ccdf19d4be43c9ea27beaec4f", "locator": {"type": "text", "quote": "The coding model is confounded with GPU class"}}]}, {"claim_id": "03-c4", "statement": "Budget the whole comparison, including baseline, candidate trials, held-out trials and optimizer overhead. The tutorial's proposed design totals 48 worker trials before optimizer and setup costs; this is planning arithmetic, not observed expenditure.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00161"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00162"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00163"}}, {"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00164"}}]}, {"claim_id": "03-c5", "statement": "Preserve failed trials and enough versioned evidence to reconstruct each result. Watch for external reproductions that include evaluator identity, configuration and reproduced values; a verification verdict alone is insufficient.", "type": "inference", "evidence": [{"item_id": "youtube-wMQB33rM28I", "version_id": "91b5117a082251bc859d7cb81ba933c439e1b0450075c2bf98b2b8112bb7d58e", "locator": {"type": "segment", "segment_id": "s00132"}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "For verification, the record should additionally identify the target hash, the reproduction configuration, the evaluator identity, and the reproduced value."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "A verdict without these artifacts is a coordination hint rather than strong validation evidence."}}, {"item_id": "59b2cb8b434efeeb70a133bc", "version_id": "66025228eaffdbf60602a9c3e085782385578f7304cce9751aff2a52b9936729", "locator": {"type": "text", "quote": "We did not rerun the winning method"}}]}, {"claim_id": "03-c6", "statement": "Choose automation by the bottleneck it removes and the evidence it preserves. Periodic's founders describe full autonomy as a non-goal and acknowledge remaining phase ambiguity and replicates; NanoProteinLM's human scale-up gate offers a computational counterpart. These accounts support retaining judgment at uncertain transitions.", "type": "inference", "evidence": [{"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00230"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00073"}}, {"item_id": "ead4cdfb34d1b428c1cd760b", "version_id": "2440cc1580de805fb537ea10d57c87f518177ce7fa5c4cf63e2260a65098b0dc", "locator": {"type": "segment", "segment_id": "s00077"}}, {"item_id": "084a91218ed6d51df5ab9f17", "version_id": "2b0d8382c674620fd174f5c60697d5bdf4728371aa386ebba1986c60e1eef65b", "locator": {"type": "text", "quote": "with a human deciding which recipes to scale up"}}]}]}
